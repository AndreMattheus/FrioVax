# Copie para .env apenas se quiser mudar os padrões locais do docker-compose.yml.
# Não use credenciais reais: estes valores servem só para o ambiente de desenvolvimento.
DB_NAME=friovax
DB_USER=friovax
DB_PASSWORD=friovax
DB_PORT=5432

# Gere chaves RSA e senhas demonstrativas com:
# bash docs/scripts/preparar-auth-local.sh
# O script cria .env.auth, usado pelo Compose. Para dev, carregue-o no shell.
# Em implantação, forneça estes valores pelo gerenciador de segredos do ambiente:
# JWT_ISSUER=friovax-api
# JWT_PRIVATE_KEY=/run/secrets/auth/privateKey.pem
# JWT_PUBLIC_KEY=/run/secrets/auth/publicKey.pem
# AUTH_DEMO_ENABLED=false
# AUTH_DEMO_ADMINISTRADOR=...
# AUTH_DEMO_OPERADOR=...
# AUTH_DEMO_AUDITOR=...
